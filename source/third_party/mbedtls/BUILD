package(default_visibility = ["//visibility:public"])

# X.509 certificate support layer, produces libmbedx509
# error.c is generated by scripts/make_generated_files.py
filegroup(
    name = "x509_srcs",
    srcs = [
        "library/error.c",
        "library/mbedtls_config.c",
        "library/pkcs7.c",
        "library/x509.c",
        "library/x509_create.c",
        "library/x509_crl.c",
        "library/x509_crt.c",
        "library/x509_csr.c",
        "library/x509_oid.c",
        "library/x509write.c",
        "library/x509write_crt.c",
        "library/x509write_csr.c",
    ],
)

# TLS layer, produces libmbedtls
# ssl_debug_helpers_generated.c and version_features.c are generated files.
filegroup(
    name = "tls_srcs",
    srcs = [
        "library/debug.c",
        "library/mps_reader.c",
        "library/mps_trace.c",
        "library/net_sockets.c",
        "library/ssl_cache.c",
        "library/ssl_ciphersuites.c",
        "library/ssl_client.c",
        "library/ssl_cookie.c",
        "library/ssl_debug_helpers_generated.c",
        "library/ssl_msg.c",
        "library/ssl_ticket.c",
        "library/ssl_tls.c",
        "library/ssl_tls12_client.c",
        "library/ssl_tls12_server.c",
        "library/ssl_tls13_client.c",
        "library/ssl_tls13_generic.c",
        "library/ssl_tls13_keys.c",
        "library/ssl_tls13_server.c",
        "library/timing.c",
        "library/version.c",
        "library/version_features.c",
    ],
)

# Public mbedtls API headers
filegroup(
    name = "include_hdrs",
    srcs = glob(["include/**/*.h"]),
)

# Private library-internal headers
filegroup(
    name = "library_hdrs",
    srcs = glob(["library/*.h"]),
)

# mbedtls config headers
filegroup(
    name = "config_hdrs",
    srcs = glob([
        "configs/*.h",
        "configs/**/*.h",
    ]),
)

filegroup(
    name = "m33_hdrs",
    srcs = [
        ":include_hdrs",
        ":library_hdrs",
        ":config_hdrs",
        "//source/third_party/mbedtls/tf-psa-crypto:extras_hdrs",
        "//source/third_party/mbedtls/tf-psa-crypto:m33_hdrs",
    ],
)

arm_cc_generic_library(
    name = "mbedx509_m33_baremetal",
    libname = "libmbedx509",
    arch = "m33",
    compilers = ["ticlang"],
    srcs = [
        ":x509_srcs",
        "//source/third_party/mbedtls/tf-psa-crypto:extras_srcs",
    ],
    hdrs = [":m33_hdrs"],
    includes = [
        # mbedtls-layer paths
        "include",
        "library",
        "configs",
        # tf-psa-crypto paths needed to compile X.509 sources that call
        # internal PSA crypto APIs
        "tf-psa-crypto/include",
        "tf-psa-crypto/drivers/builtin/include",
        "tf-psa-crypto/core",
        "tf-psa-crypto/drivers/builtin/src",
        "tf-psa-crypto/configs",
        "tf-psa-crypto/extras",
        # utilities: crypto_oid.h, asn1, base64, oid, pem, pkcs5
        "tf-psa-crypto/utilities",
    ],
    defines = [
        "MBEDTLS_CONFIG_FILE=<config-m33-baremetal.h>",
        "TF_PSA_CRYPTO_CONFIG_FILE=<crypto-config-m33-baremetal.h>",
    ],
    copts = ["-Oz"],
    deps = ["//source/third_party/mbedtls/tf-psa-crypto:tfpsacrypto_m33_baremetal"],
    visibility = ["//visibility:public"],
)

# TLS layer, depends on X.509 and PSA crypto
arm_cc_generic_library(
    name = "mbedtls_m33_baremetal",
    libname = "libmbedtls",
    arch = "m33",
    compilers = ["ticlang"],
    srcs = [":tls_srcs"],
    hdrs = [":m33_hdrs"],
    includes = [
        "include",
        "library",
        "configs",
        "tf-psa-crypto/include",
        "tf-psa-crypto/drivers/builtin/include",
        "tf-psa-crypto/core",
        "tf-psa-crypto/drivers/builtin/src",
        "tf-psa-crypto/configs",
        "tf-psa-crypto/extras",
        "tf-psa-crypto/utilities",
    ],
    defines = [
        "MBEDTLS_CONFIG_FILE=<config-m33-baremetal.h>",
        "TF_PSA_CRYPTO_CONFIG_FILE=<crypto-config-m33-baremetal.h>",
    ],
    copts = ["-Oz"],
    deps = [":mbedx509_m33_baremetal"],
    visibility = ["//visibility:public"],
)

# TF-PSA-Crypto targets made available for convenience
alias(
    name = "tfpsacrypto_m33_baremetal",
    actual = "//source/third_party/mbedtls/tf-psa-crypto:tfpsacrypto_m33_baremetal",
    visibility = ["//visibility:public"],
)

alias(
    name = "tfpsacrypto_m33_symmetric",
    actual = "//source/third_party/mbedtls/tf-psa-crypto:tfpsacrypto_m33_symmetric",
    visibility = ["//visibility:public"],
)

alias(
    name = "tfpsacrypto_m33_ccm_aes_sha256",
    actual = "//source/third_party/mbedtls/tf-psa-crypto:tfpsacrypto_m33_ccm_aes_sha256",
    visibility = ["//visibility:public"],
)

alias(
    name = "tfpsacrypto_m33_medium",
    actual = "//source/third_party/mbedtls/tf-psa-crypto:tfpsacrypto_m33_medium",
    visibility = ["//visibility:public"],
)

filegroup(
    name = "srcs",
    srcs = glob(["**"]),
    visibility = ["//visibility:public"],
)