/*
 *  ======== oscillator.Board.c.xdt ========
 */

    let Common = system.getScript("/ti/driverlib/Common.js");

    let mod = system.modules["/ti/clockTree/divider.js"];

    let mdivInst = _.find(mod.$instances, ['$name', 'MDIV']);
    let udivInst = _.find(mod.$instances, ['$name', 'UDIV']);
    let mfpdivInst = _.find(mod.$instances, ['$name', 'HFCLK4MFPCLKDIV']);
    let extdivmclkInst = _.find(mod.$instances, ['$name', 'EXTDIVMCLK']);
    let extdivcanInst = _.find(mod.$instances, ['$name', 'EXTDIVCAN']);
    let i2sdivInst = _.find(mod.$instances, ['$name', 'I2SDIV']);

    mod = system.modules["/ti/clockTree/mux.js"];

    let sysctlmuxInst = _.find(mod.$instances, ['$name', 'SYSCTLMUX'])
    let i2smuxInst = _.find(mod.$instances, ['$name', 'I2SCLKMUX'])
    let canmuxInst = _.find(mod.$instances, ['$name', 'CANCLKMUX'])

    if(!Common.isDeviceFamily_PARENT_MSPM33C321X()){
        if(_.isUndefined(mdivInst)) {
            throw 'Not all divider elements are defined appropriately';
        }
    }

    let mdivStr = "";
    let udivStr = "";
    let mfpdivStr = "";
    let extdivmclkStr = "";
    let extdivcanclkStr = "";
    let i2sclkdivStr = "";

    if(!Common.isDeviceFamily_PARENT_MSPM33C321X()){
        if(_.endsWith(sysctlmuxInst.inputSelect, "MDIV")){
            if(mdivInst.isMDIVEnabled){
                if(mdivInst.divideValue === 1){
                    mdivStr = "DL_SYSCTL_setMCLKDivider(DL_SYSCTL_MCLK_DIVIDER_DISABLE);"
                } else {
                    mdivStr = "DL_SYSCTL_setMCLKDivider(DL_SYSCTL_MCLK_DIVIDER_" + mdivInst.divideValue + ");";
                }
            }
        }
    }

    if(_.endsWith(sysctlmuxInst.inputSelect, "MDIV")){
        if(mdivInst.isMDIVEnabled){
            if(mdivInst.divideValue === 1){
                extdivmclkStr = "DL_SYSCTL_setMCLKDivider(DL_SYSCTL_MCLK_DIVIDER_DISABLE);";
            } else {
                extdivmclkStr = "DL_SYSCTL_setMCLKDivider(DL_SYSCTL_MCLK_DIVIDER_" + mdivInst.divideValue + ");";
            }
        }
    }

    if(Common.isDeviceFamily_PARENT_MSPM33C321X()){
        if(!_.isUndefined(extdivmclkInst)){
                if(extdivmclkInst.divideValue === 1){
                extdivmclkStr =  "DL_SYSCTL_disablePLLDivider( );";
                } else {
                extdivmclkStr = "DL_SYSCTL_enablePLLDivider(DL_SYSCTL_PLL_DIVIDER_DIV" + extdivmclkInst.divideValue + ");";
                }
        }
    }

    if(Common.isDeviceFamily_PARENT_MSPM33C321X()){
        if(_.endsWith(canmuxInst.inputSelect, "EXTDIVCAN")){
            if(!_.isUndefined(extdivcanInst)){
                    if(extdivcanInst.divideValue != 1){
                        extdivcanclkStr = "DL_SYSCTL_enableCANCLKDivider(DL_SYSCTL_CANPLL_DIVIDER_DIV" + extdivcanInst.divideValue + ");";
                    }
            }
        }
    }

     if(Common.isDeviceFamily_PARENT_MSPM33C321X()){
        if(_.endsWith(i2smuxInst.inputSelect, "I2SDIV")){
            if(!_.isUndefined(i2sdivInst)){
                    if(i2sdivInst.divideValue != 1){
                        i2sclkdivStr = "DL_SYSCTL_enableI2SCLKDivider(DL_SYSCTL_I2SPLL_DIVIDER_DIV" + i2sdivInst.divideValue + ");";
                    }
            }
        }
     }

    if(!_.isUndefined(mfpdivInst)){
        if(mfpdivInst.divideValue != 1){
            mfpdivStr = "DL_SYSCTL_setHFCLKDividerForMFPCLK(DL_SYSCTL_HFCLK_MFPCLK_DIVIDER_" + mfpdivInst.divideValue + ");";
        }
    }

%%}
%
% if(mdivStr !== ""){
    `mdivStr`
% }
% if(udivStr !== ""){
    `udivStr`
% }
% if(mfpdivStr !== ""){
    `mfpdivStr`
% }
% if(extdivmclkStr !== ""){
    `extdivmclkStr`
% }
% if(extdivcanclkStr !== ""){
    `extdivcanclkStr`
% }
% if(i2sclkdivStr !== ""){
    `i2sclkdivStr`
% }
