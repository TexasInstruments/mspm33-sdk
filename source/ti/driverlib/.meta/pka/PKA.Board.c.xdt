/*
 *  ======== PKA.Board.c.xdt ========
 *  PKA module for MSPM33
 */

    let PKA = args[0];
    let content = args[1];

    /* shorthand names for some common references in template below */
    let stat = PKA.$static;
    if (stat.length == 0) return;


    switch(content){
        case "Call":
            printCall();
            break;
        case "Reset":
            printReset();
            break;
        case "Power":
            printPower();
            break;
        case "GPIO":
            printGPIO();
            break;
        case "Function":
            printFunction();
            break;
        default:
            /* do nothing */
            return;
            break;
    }
%%}
%
% function printCall(){
    SYSCFG_DL_PKA_init();
% }
%
% function printReset(){
    DL_PKA_resetAssert(PKA_INST);
% }
% function printPower(){
    DL_PKA_enable(PKA_INST);
% }
%
% function printGPIO(){
%       /* all of these are defined in the header */
%       // No need to initialize GPIOs for PKA functionality
% }
%
% /* Main Function */
% function printFunction(){
SYSCONFIG_WEAK void SYSCFG_DL_PKA_init(void)
{
    /* Wait for reset to complete */
    while(!DL_PKA_getResetStatus(PKA_INST));

    DL_PKA_resetStickyFlagClear(PKA_INST);
    DL_PKAClearDataRam(PKA_INST);
% if(stat.interruptEnable){
    /* Enable PKA interrupt */
    DL_PKA_enableInterrupt();
%        if(stat.interruptPriority !== "DEFAULT"){
%               let irqnStr = "PKA_IRQn";
    NVIC_SetPriority(`irqnStr`, `stat.interruptPriority`);
%        }
% }
}
%
%
% } // printFunction()
