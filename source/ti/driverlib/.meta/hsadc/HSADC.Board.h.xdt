/*
 *  ======== HSADC.Board.h.xdt ========
 */

    /* args[] passed by /ti/driverlib/templates/Board.h.xdt */
    let HSADC = args[0];
    let content = args[1];

    /* get ti/drivers common utility functions */
    let Common = system.getScript("/ti/driverlib/Common.js");

    let instances = HSADC.$instances;

    switch(content) {
        case "Define":
            printDefine();
            break;
        case "Declare":
            printDeclare();
            break;
        default:
            /* do nothing */
            return;
    }

%%}
%
%
% function printDefine() {
% for(let i = 0; i < instances.length; i++) {
%   let inst = instances[i];
%   let solution    = inst.peripheral.$solution;
%   let peripheral  = system.deviceData.peripherals[solution.peripheralName];
%   let nameStr = "#define "+ inst.$name +"_INST";
%   let resultnameStr = "#define "+ inst.$name + "_RESULT_INST";

/* Defines for `inst.$name` */
`nameStr.padEnd(40," ")+(peripheral.name + "_ADC_LITE_REGS").padStart(40," ")`
`resultnameStr.padEnd(40," ")+(peripheral.name + "_ADC_LITE_RESULT_REGS").padStart(40," ")`
%   for(let j=0; j<inst.enabledInts.length; j++){
%       let intirqNameStr = nameStr+"_INT"+inst.enabledInts[j].replace("ADC_INT_NUMBER_", "")+"_IRQN"
%       let intirqhandNameStr = nameStr+"_INT"+inst.enabledInts[j].replace("ADC_INT_NUMBER_", "")+"_IRQHandler"
%       let flavorINTIRQ = inst.peripheral.$solution.peripheralName+"_INT_PUB"+inst.enabledInts[j].replace("ADC_INT_NUMBER_", "")+"_INT_IRQn";
%       let flavorINTHandler = inst.peripheral.$solution.peripheralName+"_SEQ"+(inst.enabledInts[j].replace("ADC_INT_NUMBER_", "") - 1)+"_IRQHandler ";
`intirqNameStr.padEnd(40," ")+flavorINTIRQ.padStart(40," ")`
`intirqhandNameStr.padEnd(40," ")+flavorINTHandler.padStart(40," ")`
%   }
% if(inst.adcEventInterrupt){
% let intirqevtNameStr = nameStr+"_INT_EVT_IRQN"
% let intirqevthandNameStr = nameStr+"_INT_EVT_IRQHandler"
% let flavorINTEVTIRQ = inst.peripheral.$solution.peripheralName+"_EVT_INT_PUB1_INT_IRQn";
% let flavorINTEVTHandler = inst.peripheral.$solution.peripheralName+"_DCOMP_IRQHandler";
`intirqevtNameStr.padEnd(40," ")+flavorINTEVTIRQ.padStart(40," ")`
`intirqevthandNameStr.padEnd(40," ")+flavorINTEVTHandler.padStart(40," ")`
% }
% }
% } // function printDefine
%
% function printDeclare() {
%   for (let i in instances) {
%       let inst = instances[i];
void SYSCFG_DL_`inst.$name`_init(void);
%   }
% }
