/*
 *  ============ boot_config.c =============
 *  Configured MSPM0 NONMAIN options
 *
 *  DO NOT EDIT - This file is generated by the SysConfig tool.
 */

#include "boot_config.h"
#include "ti_msp_dl_config.h"
%
%%{
    let debugAccessStr = "BC_CFG_DEBUG_DIS";  // Default to disabled
    if (inst.apEnable === "enabled") {
        // Level 0 - Full access, no authentication
        debugAccessStr = "BC_CFG_DEBUG_L0";
    } else if (inst.apEnable === "level1") {
        // Level 1 - Secure password protected, Non-secure enabled
        debugAccessStr = "BC_CFG_DEBUG_L1";
    } else if (inst.apEnable === "level2") {
        // Level 2 - Both secure and non-secure password protected
        debugAccessStr = "BC_CFG_DEBUG_L2";
    }

    let massEraseStr = "BC_CFG_MASS_ERASE_DIS";
    if (inst.meMode == "enabled")
    {
        massEraseStr = "BC_CFG_MASS_ERASE_EN";
    }
    else if (inst.meMode == "enabledWithPW")
    {
        massEraseStr = "BC_CFG_MASS_ERASE_EN_PW";
    }

    let factoryResetStr = "BC_CFG_FACTORY_RESET_DIS";
    if (inst.frMode == "enabled")
    {
        factoryResetStr = "BC_CFG_FACTORY_RESET_EN";
    }
    else if (inst.frMode == "enabledWithPW")
    {
        factoryResetStr = "BC_CFG_FACTORY_RESET_EN_PW";
    }
%%}
%
%%{
function createHexStr(value)
{
    if (value == 0xFFFFFFFF)
    {
        return ("CFG_DEFAULT_VALUE");
    }

    return ("0x" + value.toString(16));
}
%%}

%%{
/* Helper function to format protection values as unsigned 32-bit hex */
function formatProtectionValue(value) {
    // Ensure unsigned 32-bit value and format with UL suffix
    return `0x${(value >>> 0).toString(16).toUpperCase().padStart(8, '0')}UL`;
}
%%}

/* Bootcode configuration */

PLACE_IN_MEMORY(".BCRConfig")
const BCR_Config BCRConfig =
{
    .BCR_CONFIG_ID = 0x05000000,
    .DEBUG_ACCESS = `debugAccessStr`,
    .SWDP_MODE = `inst.swdEnable ? "BC_CFG_SW_DP_EN" : "BC_CFG_SW_DP_DIS"`,
    .BSL_PIN_INVOKE = `inst.bslInvokePinCheck ? "BC_CFG_BSL_PIN_INVOKE_EN" : "BC_CFG_BSL_PIN_INVOKE_DIS"`,
    .DEBUG_HOLD = `inst.debugHold !== undefined ? (inst.debugHold ? "BC_CFG_DEBUG_HOLD_EN" : "BC_CFG_DEBUG_HOLD_DIS") : "BC_CFG_DEBUG_HOLD_DIS"`,
    .CSC_EXISTS = `inst.cscExists !== undefined ? (inst.cscExists ? "BC_CFG_CSC_EXIST" : "BC_CFG_CSC_NOT_EXIST") : "BC_CFG_CSC_NOT_EXIST"`,
    .FLASH_BANK_SWAP_POLICY = `inst.flashBankSwap !== undefined ? (inst.flashBankSwap ? "BC_CFG_FLASH_BS_EN" : "BC_CFG_FLASH_BS_DIS") : "BC_CFG_FLASH_BS_DIS"`,
    .FAST_BOOT_MODE = `inst.fastBootMode ? "BC_CFG_FAST_BOOT_EN" : "BC_CFG_FAST_BOOT_DIS"`,

    .SERVICES = {
        .BOOTLOADER_MODE = `inst.bslMode ? "BC_CFG_BOOTLOADER_MODE_EN" : "BC_CFG_BOOTLOADER_MODE_DIS"`,
        .MASS_ERASE_MODE = `massEraseStr`,
        .FACTORY_RESET_MODE = `factoryResetStr`,
    },

    .PASSWORDS = {
        .MASS_ERASE = {
            `createHexStr(inst.mePW0)`, `createHexStr(inst.mePW1)`, `createHexStr(inst.mePW2)`, `createHexStr(inst.mePW3)`,
            `createHexStr(inst.mePW4)`,`createHexStr(inst.mePW5)`, `createHexStr(inst.mePW6)`, `createHexStr(inst.mePW7)`,
        },
        .FACTORY_RESET = {
            `createHexStr(inst.frPW0)`, `createHexStr(inst.frPW1)`, `createHexStr(inst.frPW2)`, `createHexStr(inst.frPW3)`,
            `createHexStr(inst.frPW4)`,`createHexStr(inst.frPW5)`, `createHexStr(inst.frPW6)`, `createHexStr(inst.frPW7)`,
        },
        .DEBUG_LOCK = {
            `createHexStr(inst.dbglockPW0)`, `createHexStr(inst.dbglockPW1)`, `createHexStr(inst.dbglockPW2)`, `createHexStr(inst.dbglockPW3)`,
            `createHexStr(inst.dbglockPW4)`,`createHexStr(inst.dbglockPW5)`, `createHexStr(inst.dbglockPW6)`, `createHexStr(inst.dbglockPW7)`,
        },
        .DEBUG_NS_LOCK = {
            `createHexStr(inst.dbgnslockPW0)`, `createHexStr(inst.dbgnslockPW1)`, `createHexStr(inst.dbgnslockPW2)`, `createHexStr(inst.dbgnslockPW3)`,
            `createHexStr(inst.dbgnslockPW4)`,`createHexStr(inst.dbgnslockPW5)`, `createHexStr(inst.dbgnslockPW6)`, `createHexStr(inst.dbgnslockPW7)`,
        },
        .RSVD_PSWD = {
            `createHexStr(inst.badConvPW0)`, `createHexStr(inst.badConvPW1)`,
            `createHexStr(inst.badConvPW2)`, `createHexStr(inst.badConvPW3)`,
            `createHexStr(inst.badConvPW4)`, `createHexStr(inst.badConvPW5)`,
            `createHexStr(inst.badConvPW6)`, `createHexStr(inst.badConvPW7)`
        },
    },

    .SECURE_BOOT_MODE = `inst.secureBootMode === "crcCheck" ? "BC_CFG_SECURE_BOOT_CRC_EN" : (inst.secureBootMode === "hashCheck" ? "BC_CFG_SECURE_BOOT_HASH_EN" : "BC_CFG_SECURE_BOOT_DIS")`,
    .BC_RESERVED_0 = 0xFFFF,
    .USER_SECURE_APP_START_ADDR = CFG_DEFAULT_VALUE,
    .USER_SECURE_APP_LENGTH = CFG_DEFAULT_VALUE,
    .USER_SECURE_APP_HASH = {
        `inst.secureBootMode === "hashCheck" ?
        "0x" + inst.appAuthHashValue0.toString(16) + ", " + "0x" + inst.appAuthHashValue1.toString(16) + ", " +
        "0x" + inst.appAuthHashValue2.toString(16) + ", " + "0x" + inst.appAuthHashValue3.toString(16) + ", " +
        "0x" + inst.appAuthHashValue4.toString(16) + ", " + "0x" + inst.appAuthHashValue5.toString(16) + ", " +
        "0x" + inst.appAuthHashValue6.toString(16) + ", " + "0x" + inst.appAuthHashValue7.toString(16) :
        inst.secureBootMode === "crcCheck" ?
        "0x" + inst.appAuthCRCValue.toString(16) + ", 0x00000000, " +
        "0x00000000, 0x00000000, " +
        "0x00000000, 0x00000000, " +
        "0x00000000, 0x00000000" :
        "CFG_DEFAULT_VALUE, CFG_DEFAULT_VALUE, " +
        "CFG_DEFAULT_VALUE, CFG_DEFAULT_VALUE, " +
        "CFG_DEFAULT_VALUE, CFG_DEFAULT_VALUE, " +
        "CFG_DEFAULT_VALUE, CFG_DEFAULT_VALUE"`
    },

    .GSC_CONFIGS = {
        .BANK0_NM_USER_CONFIG = `(inst.nonMainWriteProtection === "enabled") ? "BC_CFG_NONMAIN_WRITE_PROTECT_EN" : "BC_CFG_NONMAIN_WRITE_PROTECT_DIS"`,
        .BC_RESERVED_1 = 0xFFFF,
        .BANK0 = {
            .WRITE_ERASE_PROTECTION_A = `formatProtectionValue(inst.bank0WriteEraseProtectionA)`,
            .WRITE_ERASE_PROTECTION_B = `formatProtectionValue(inst.bank0WriteEraseProtectionB)`,
            .SECURITY_PROTECTION_A = `formatProtectionValue(inst.bank0SecurityProtectionA)`,
            .SECURITY_PROTECTION_B = `formatProtectionValue(inst.bank0SecurityProtectionB)`,
            .PRIVILEGE_PROTECTION_A = `formatProtectionValue(inst.bank0PrivilegeProtectionA)`,
            .PRIVILEGE_PROTECTION_B = `formatProtectionValue(inst.bank0PrivilegeProtectionB)`,
            .reserved = 0xFFFFFFFF
        },
        .BANK1 = {
            .WRITE_ERASE_PROTECTION_A = `formatProtectionValue(inst.bank1WriteEraseProtectionA)`,
            .WRITE_ERASE_PROTECTION_B = `formatProtectionValue(inst.bank1WriteEraseProtectionB)`,
            .SECURITY_PROTECTION_A = `formatProtectionValue(inst.bank1SecurityProtectionA)`,
            .SECURITY_PROTECTION_B = `formatProtectionValue(inst.bank1SecurityProtectionB)`,
            .PRIVILEGE_PROTECTION_A = `formatProtectionValue(inst.bank1PrivilegeProtectionA)`,
            .PRIVILEGE_PROTECTION_B = `formatProtectionValue(inst.bank1PrivilegeProtectionB)`,
            .reserved = 0xFFFFFFFF
        },
        .DBANK = {
            /* For Write/Erase Protection:
             * Upper 16 bits: 0xFFFF (default/unprogrammed state)
             * Lower 16 bits: Protection configuration
             */
            .WRITE_ERASE_PROTECTION = `formatProtectionValue((0xFFFF << 16) | (inst.dbankWriteEraseProtection & 0xFFFF))`,

            /* For Security Protection:
             * Upper 16 bits: 0x0000 (secure)
             * Lower 16 bits: Protection configuration
             */
            .SECURITY_PROTECTION = `formatProtectionValue((0x0000 << 16) | (inst.dbankSecurityProtection & 0xFFFF))`,

            /* For Privilege Protection:
             * Upper 16 bits: 0x0000 (privileged)
             * Lower 16 bits: Protection configuration
             */
            .PRIVILEGE_PROTECTION = `formatProtectionValue((0x0000 << 16) | (inst.dbankPrivilegeProtection & 0xFFFF))`,

            .reserved = 0xFFFFFFFF
        }
    },

    .SYSPLL_CONFIG = `inst.syspllConfig`,
    .SYSPLL_CONFIG_QDIV = `createHexStr(inst.syspllConfigQDiv)`,
    .SYSPLL_CONFIG_RDIV = `createHexStr(inst.syspllConfigRDiv)`,
    .SYSPLL_SOURCE = `inst.syspllSource`,
    .SYSPLL_SETTLING_TIME = `createHexStr(inst.syspllSettlingTime)`,
    .HFXT_STARTUP_MONITOR_TIME = `createHexStr(inst.hfxtStartupMonitorTime)`,

    .RESVD = {
        0xFFFF, 0xFFFF, 0xFFFF, 0xFFFF, 0xFFFF,
        0xFFFF, 0xFFFF, 0xFFFF, 0xFFFF, 0xFFFF, 0xFFFF
    },

    .CRC = `inst.bootCRC !== undefined ? createHexStr(inst.bootCRC) : "CFG_DEFAULT_VALUE"`
};

%
%   if (!Common.isDeviceM0C()) {
%%{
    let pluginTypeStr = "BSL_CFG_PLUGIN_TYPE_ANY";
    let securityAlertStr = "BSL_CFG_SECURITY_IGNORE";
    if (inst.bslSecurityConfig == "triggerFactoryReset")
    {
        securityAlertStr = "BSL_CFG_SECURITY_FACTORY_RESET";
    }
    else if (inst.bslSecurityConfig == "disableBSL")
    {
        securityAlertStr = "BSL_CFG_SECURITY_DISABLE_BSL";
    }
%%}

/* Bootloader configuration */

PLACE_IN_MEMORY(".BSLConfig")
const BSL_Config BSLConfig =
{
    .BSL_CONFIG_ID = `createHexStr(inst.bslConfigID)`,
    .BLINTERFACE_PINS = {
        .UART_RXD_pad_num = DEF_UART_RXD_PAD,
        .UART_RXD_PF_mux_sel = DEF_UART_RXD_MUX,
        .UART_TXD_pad_num = DEF_UART_TXD_PAD,
        .UART_TXD_PF_mux_sel = DEF_UART_TXD_MUX,
        .I2C_SDA_pad_num = DEF_I2C_SDA_PAD,
        .I2C_SDA_PF_mux_sel = DEF_I2C_SDA_MUX,
        .I2C_SCL_pad_num = DEF_I2C_SCL_PAD,
        .I2C_SCL_PF_mux_sel = DEF_I2C_SCL_MUX,
        .MCAN_RX_pad_num = DEF_MCAN_RXD_PAD,
        .MCAN_RX_PF_mux_sel = DEF_MCAN_RXD_MUX,
        .MCAN_TX_pad_num = DEF_MCAN_TXD_PAD,
        .MCAN_TX_PF_mux_sel = DEF_MCAN_TXD_MUX
    },
    .BSLPIN_INVOKE = {
        .Pin_data_0 = DEFAULT_BSL_PIN_INVOCATION_DATA0,
        .Pin_data_1 = DEFAULT_BSL_PIN_INVOCATION_DATA1
    },
    .READOUT = `inst.bslEnableReadOut ? "BSL_CFG_MEMORY_READOUT_ENABLE" : "BSL_CFG_MEMORY_READOUT_DISABLE"`,
    .PASSWORD = {
        `createHexStr(inst.bslPW7)`,
        `createHexStr(inst.bslPW6)`,
        `createHexStr(inst.bslPW5)`,
        `createHexStr(inst.bslPW4)`,
        `createHexStr(inst.bslPW3)`,
        `createHexStr(inst.bslPW2)`,
        `createHexStr(inst.bslPW1)`,
        `createHexStr(inst.bslPW0)`
    },
    .APP_REV_POINTER = `"(uint32_t *) " + createHexStr(inst.bslAppVersion)`,
    .SECURITY_ALERT_LEVEL = `securityAlertStr`,
    .UART_BAUD_RATE = BL_CFG_UART_BAUDRATE_9600,
    .I2C_SLAVE_ADDR = 0x48,
    .RESERVED = {
        0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF,
        0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF
    },
    .CRC = `createHexStr(inst.bslCRC)`
};

/* Added for secondary_bsl to build */
%   } // !(Common.isDeviceM0C())
/* 'main' function will never get called */
#if defined(__ti_version__) || defined(__TI_COMPILER_VERSION__)
__attribute__((weak)) int main(void)
{
    return (0);
}
#elif defined(__IAR_SYSTEMS_ICC__)
__weak int main(void);
#elif (defined(__ARMCC_VERSION) && (__ARMCC_VERSION >= 6010050)) || defined(__GNUC__)
__attribute__((weak)) int main(void);
#else
#error "Non-Main table currently not supported for this compiler"
#endif
