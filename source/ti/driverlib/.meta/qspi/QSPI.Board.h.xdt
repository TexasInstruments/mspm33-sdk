/*
 *  ======== QSPI.Board.h.xdt ========
 */

    let QSPI = args[0]; /* passed by /ti/driverlib/templates/Board.c.xdt */
    let content = args[1];

    /* get ti/drivers common utility functions */
    let Common = system.getScript("/ti/driverlib/Common.js");

    let instances = QSPI.$instances;
    let defs = Common.genBoardHeader(instances, QSPI);

    switch(content) {
        case "Define":
            printDefine();
            break;
        case "Declare":
            printDeclare();
            break;
        default:
            /* do nothing */
            return;
    }

%%}
%
% function printDefine() {
%   for (let i in instances) {
%       let inst = instances[i];
%       let flavor = inst.peripheral.$solution.peripheralName;
%       let nameStr = "#define "+inst.$name+"_INST";
%       let intHandlerStr = nameStr + "_IRQHandler";
%       let intHandlerStr2 = flavor + "_IRQHandler";
%       let intNumberStr = nameStr + "_INT_IRQN";
%       let intNumberStr2 = flavor + "_INT_IRQn";
/* Defines for `inst.$name` */
`nameStr.padEnd(40," ")+flavor.padStart(39," ")`
`intHandlerStr.padEnd(40, " ") + intHandlerStr2.padStart(39, " ")`
`intNumberStr.padEnd(40, " ") + intNumberStr2.padStart(39, " ")`
%   let usePICO = false;
%   let usePOCI = false;
%   let useIO2 = false;
%   let useIO3 = false;
%   if(inst.direction == "PICO_POCI") {
%       usePICO = true;
%       usePOCI = true;
%   }
%   if(inst.direction == "PICO_POCI_IO2_IO3") {
%       usePICO = true;
%       usePOCI = true;
%       useIO2 = true;
%       useIO3 = true;
%   }
%
%       let gpioStr = "GPIO_"+inst.$name;
% if (usePICO) {
%       let picoPinName = "pico"+"Pin";
%       let picoPackagePin = inst.peripheral[picoPinName].$solution.packagePinName;
%       let picoPinCM = Common.getPinCM(picoPackagePin,inst,'PICO');
%       let picoGpioName = system.deviceData.devicePins[picoPackagePin].mux.muxSetting.find(item => item["mode"] === "1").peripheralPin.peripheralName;
%       let picoPort    = Common.getGPIOPortMultiPad(picoPackagePin, inst, 'PICO');
%       let picoGpioPin = Common.getGPIONumberMultiPad(picoPackagePin, inst, 'PICO');
% let picoPortStr = "#define "+gpioStr+"_PICO_PORT";
`picoPortStr.padEnd(40," ")+picoPort.padStart(39, " ")`
% let picoPinStr = "#define "+gpioStr+"_PICO_PIN";
% let picoPinStr2 = "DL_GPIO_PIN_"+picoGpioPin;
`picoPinStr.padEnd(40," ")+picoPinStr2.padStart(39," ")`
% let picoIOmuxStr = "#define "+gpioStr+"_IOMUX_PICO";
% let picoIOmuxStr2 = "(IOMUX_PINCM"+picoPinCM.toString()+")";
`picoIOmuxStr.padEnd(40," ")+picoIOmuxStr2.padStart(39," ")`
% let picoFuncStr = "#define "+gpioStr+"_IOMUX_PICO_FUNC";
% let picoFuncStr2 = "IOMUX_PINCM"+picoPinCM+"_PF_"+flavor+"_PICO";
`picoFuncStr.padEnd(50, " ")+picoFuncStr2.padStart(29, " ")`
%} //if (usePICO)
% if (usePOCI) {
%       let pociPinName = "poci"+"Pin";
%       let pociPackagePin = inst.peripheral[pociPinName].$solution.packagePinName;
%       let pociPinCM = Common.getPinCM(pociPackagePin,inst,'POCI');
%       let pociGpioName = system.deviceData.devicePins[pociPackagePin].mux.muxSetting.find(item => item["mode"] === "1").peripheralPin.peripheralName;
%       let pociPort    = Common.getGPIOPortMultiPad(pociPackagePin, inst, 'POCI');
%       let pociGpioPin = Common.getGPIONumberMultiPad(pociPackagePin, inst, 'POCI');
% let pociPortStr = "#define "+gpioStr+"_POCI_PORT";
`pociPortStr.padEnd(40," ")+pociPort.padStart(39, " ")`
% let pociPinStr = "#define "+gpioStr+"_POCI_PIN";
% let pociPinStr2 = "DL_GPIO_PIN_"+pociGpioPin;
`pociPinStr.padEnd(40," ")+pociPinStr2.padStart(39," ")`
% let pociIOmuxStr = "#define "+gpioStr+"_IOMUX_POCI";
% let pociIOmuxStr2 = "(IOMUX_PINCM"+pociPinCM.toString()+")";
`pociIOmuxStr.padEnd(40," ")+pociIOmuxStr2.padStart(39," ")`
% let pociFuncStr = "#define "+gpioStr+"_IOMUX_POCI_FUNC";
% let pociFuncStr2 = "IOMUX_PINCM"+pociPinCM+"_PF_"+flavor+"_POCI";
`pociFuncStr.padEnd(50, " ")+pociFuncStr2.padStart(29, " ")`
%} //if (usePOCI)
% if (useIO2) {
%       let io2PinName = "io2"+"Pin";
%       let io2PackagePin = inst.peripheral[io2PinName].$solution.packagePinName;
%       let io2PinCM = Common.getPinCM(io2PackagePin,inst,'IO2');
