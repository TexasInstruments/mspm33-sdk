%       let io3PackagePin = inst.peripheral[io3PinName].$solution.packagePinName;
%       let io3PinCM = Common.getPinCM(io3PackagePin,inst,'IO3');
%       let io3GpioName = system.deviceData.devicePins[io3PackagePin].mux.muxSetting.find(item => item["mode"] === "1").peripheralPin.peripheralName;
