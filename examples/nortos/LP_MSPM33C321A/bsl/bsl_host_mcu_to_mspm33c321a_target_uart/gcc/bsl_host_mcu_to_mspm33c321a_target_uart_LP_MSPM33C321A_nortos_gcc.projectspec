<?xml version="1.0" encoding="UTF-8"?>
<projectSpec>
    <applicability>
        <when>
            <context
                deviceFamily="ARM"
                deviceId="MSPM33C321A"
            />
        </when>
    </applicability>

    <project
        title="bsl_host_mcu_to_mspm33c321a_target_uart"
        name="bsl_host_mcu_to_mspm33c321a_target_uart_LP_MSPM33C321A_nortos_gcc"
        configurations="Debug"
        toolChain="GNU"
        connection="TIXDS110_Connection.xml"
        device="MSPM33C321A"
        ignoreDefaultDeviceSettings="true"
        ignoreDefaultCCSSettings="true"
        products="MSPM33-SDK;sysconfig"
        compilerBuildOptions="
            -I${PROJECT_ROOT}
            -I${PROJECT_ROOT}/${ConfigName}
            -mfloat-abi=hard
            -mfpu=fpv5-sp-d16
            -DUART_Plugin
            -O2
            -g
            @device.opt
            -I${COM_TI_MSPM33_SDK_INSTALL_DIR}/source/third_party/CMSIS/Core/Include
            -I${COM_TI_MSPM33_SDK_INSTALL_DIR}/source
            -mcpu=cortex-m33
            -mthumb
            -std=c99
            -std=c++11
            -ffunction-sections
            -fdata-sections
            -Wall
            -I${CG_TOOL_ROOT}/arm-none-eabi/include
        "
        linkerBuildOptions="
            -nostartfiles
            -mfloat-abi=hard
            -mfpu=fpv5-sp-d16
            -Tdevice.lds.genlibs
            -L${COM_TI_MSPM33_SDK_INSTALL_DIR}/source
            -L${PROJECT_ROOT}
            -L${PROJECT_BUILD_DIR}/syscfg
            -mcpu=cortex-m33
            -mthumb
            -static
            -Wl,--gc-sections
            -lgcc
            -lc
            -lm
            --specs=nosys.specs
        "
        sysConfigBuildOptions="
            --output .
            --product ${COM_TI_MSPM33_SDK_INSTALL_DIR}/.metadata/product.json
            --compiler gcc
        "
        sourceLookupPath="${COM_TI_MSPM33_SDK_INSTALL_DIR}/source/ti/driverlib"
        description="Demonstrate how to program a MSPM33 MCU using a LP-MSPM33C321A as host by BSL UART interface.">
        <property name="buildProfile" value="release"/>
        <property name="isHybrid" value="true"/>
        <file path="../application_image_uart.h" openOnCreation="false" excludeFromBuild="false" action="copy">
        </file>
        <file path="../bsl_uart.c" openOnCreation="false" excludeFromBuild="false" action="copy">
        </file>
        <file path="../bsl_uart.h" openOnCreation="false" excludeFromBuild="false" action="copy">
        </file>
        <file path="../uart.c" openOnCreation="false" excludeFromBuild="false" action="copy">
        </file>
        <file path="../uart.h" openOnCreation="false" excludeFromBuild="false" action="copy">
        </file>
        <file path="../main.c" openOnCreation="false" excludeFromBuild="false" action="copy">
        </file>
        <file path="../bsl_host_mcu_uart.syscfg" openOnCreation="true" excludeFromBuild="false" action="copy">
        </file>
        <file path="../README.md" openOnCreation="true" excludeFromBuild="false" action="copy">
        </file>
        <file path="../README.html" openOnCreation="false" excludeFromBuild="false" action="copy">
        </file>
    </project>
</projectSpec>