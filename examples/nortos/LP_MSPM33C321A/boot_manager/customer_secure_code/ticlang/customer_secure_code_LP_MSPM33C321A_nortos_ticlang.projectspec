<?xml version="1.0" encoding="UTF-8"?>
<projectSpec>
    <applicability>
        <when>
            <context
                deviceFamily="ARM"
                deviceId="MSPM33C321A"
            />
        </when>
    </applicability>

    <project
        title="customer_secure_code"
        name="customer_secure_code_LP_MSPM33C321A_nortos_ticlang"
        configurations="Debug"
        toolChain="TICLANG"
        connection="TIXDS110_Connection.xml"
        device="MSPM33C321A"
        ignoreDefaultDeviceSettings="true"
        ignoreDefaultCCSSettings="true"
        products="MSPM33-SDK;sysconfig"
        compilerBuildOptions="
            -I${PROJECT_ROOT}
            -I${PROJECT_ROOT}/${ConfigName}
            -D__MSPM33C321A__
            -DEXCLUDE_TRACE
            -Oz
            -flto
            -I${COM_TI_MSPM33_SDK_INSTALL_DIR}/source/third_party/mcuboot/boot/bootutil/include
            -I${COM_TI_MSPM33_SDK_INSTALL_DIR}/source/third_party/mcuboot/ext/mbedtls-asn1/include
            -I${COM_TI_MSPM33_SDK_INSTALL_DIR}/source/third_party/mcuboot/ext/
            -I${COM_TI_MSPM33_SDK_INSTALL_DIR}/source/ti/boot_manager/ecc/include
            -I${COM_TI_MSPM33_SDK_INSTALL_DIR}/source/ti/boot_manager/sha2sw/inc
            -I${COM_TI_MSPM33_SDK_INSTALL_DIR}/source/ti/boot_manager/ecc/src
            -I${COM_TI_MSPM33_SDK_INSTALL_DIR}/source/third_party/CMSIS/Core/Include
            -I${COM_TI_MSPM33_SDK_INSTALL_DIR}/source
            -mcpu=cortex-m33
            -Wall
        "
        linkerBuildOptions="
            -l${COM_TI_MSPM33_SDK_INSTALL_DIR}/source/ti/boot_manager/lib/ticlang/m33/bimsupport.a
            -l${COM_TI_MSPM33_SDK_INSTALL_DIR}/source/ti/crypto/lib/ticlang/m33/mspm33c321x/cryptolib.a
            -Wl,--stack_size=256
            -Wl,--heap_size=128
            -l${COM_TI_MSPM33_SDK_INSTALL_DIR}/source/ti/driverlib/lib/ticlang/m33/mspm33c321x/driverlib.a
            -L${COM_TI_MSPM33_SDK_INSTALL_DIR}/source
            -L${PROJECT_ROOT}
            -L${PROJECT_BUILD_DIR}/syscfg
            -Wl,--rom_model
            -Wl,--warn_sections
            -L${CG_TOOL_ROOT}/lib
            -llibc.a
        "
        sysConfigBuildOptions="
            --output .
            --product ${COM_TI_MSPM33_SDK_INSTALL_DIR}/.metadata/product.json
            --compiler ticlang
        "
        sourceLookupPath="${COM_TI_MSPM33_SDK_INSTALL_DIR}/source/ti/driverlib"
        description="Customer Secure Code based off MCUBoot">
        <property name="buildProfile" value="release"/>
        <property name="isHybrid" value="true"/>
