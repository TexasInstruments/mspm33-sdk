<?xml version="1.0" encoding="UTF-8"?>
<projectSpec>
    <applicability>
        <when>
            <context
                deviceFamily="ARM"
                deviceId="MSPM33C321A"
            />
        </when>
    </applicability>

    <project
        title="tida_010997_boosterpack_data_capture"
        name="tida_010997_boosterpack_data_capture_LP_MSPM33C321A_nortos_ticlang"
        configurations="Debug"
        toolChain="TICLANG"
        connection="TIXDS110_Connection.xml"
        device="MSPM33C321A"
        ignoreDefaultDeviceSettings="true"
        ignoreDefaultCCSSettings="true"
        products="MSPM33-SDK;sysconfig"
        compilerBuildOptions="
            -I${PROJECT_ROOT}
            -I${PROJECT_ROOT}/${ConfigName}
            -DDEVICE_NAME=MSPM33C321A
            -DARM_MATH_CM33
            -O0
            -Wall
            -gdwarf-3
            -mfloat-abi=hard
            -mfpu=fpv5-sp-d16
            @device.opt
            -I${COM_TI_MSPM33_SDK_INSTALL_DIR}/source/third_party/CMSIS/Core/Include
            -I${COM_TI_MSPM33_SDK_INSTALL_DIR}/source/third_party/CMSIS/DSP/Include
            -I${COM_TI_MSPM33_SDK_INSTALL_DIR}/examples/edgeAI/tida_010997_boosterpack_data_capture/LP_MSPM33C321A
            -I${COM_TI_MSPM33_SDK_INSTALL_DIR}/source/ti/hal/mspm33/include
            -I${COM_TI_MSPM33_SDK_INSTALL_DIR}/source
            -mcpu=cortex-m33
        "
        linkerBuildOptions="
            -ldevice.cmd.genlibs
            -L${COM_TI_MSPM33_SDK_INSTALL_DIR}/source
            -L${PROJECT_ROOT}
            -L${PROJECT_BUILD_DIR}/syscfg
            -Wl,--rom_model
            -Wl,--warn_sections
            -L${CG_TOOL_ROOT}/lib
            -llibc.a
        "
        sysConfigBuildOptions="
            --output .
            --product ${COM_TI_MSPM33_SDK_INSTALL_DIR}/.metadata/product.json
            --compiler ticlang
        "
        sourceLookupPath="${COM_TI_MSPM33_SDK_INSTALL_DIR}/source/ti/driverlib"
        description="Multi-sensor data capture (PIR + HDC temperature/humidity + ambient light + pressure) using Device Agent Protocol for Edge AI Studio">
        <property name="buildProfile" value="release"/>
        <property name="isHybrid" value="true"/>
        <file path="../app_cfg.h" openOnCreation="false" excludeFromBuild="false" action="copy">
        </file>
        <file path="../comm/i2c_comm.c" openOnCreation="false" excludeFromBuild="false" action="copy" targetDirectory="comm">
        </file>
        <file path="../comm/i2c_comm.h" openOnCreation="false" excludeFromBuild="false" action="copy" targetDirectory="comm">
        </file>
        <file path="../comm/spi_comm.c" openOnCreation="false" excludeFromBuild="false" action="copy" targetDirectory="comm">
        </file>
        <file path="../comm/spi_comm.h" openOnCreation="false" excludeFromBuild="false" action="copy" targetDirectory="comm">
        </file>
        <file path="../dap/dap_interface.c" openOnCreation="false" excludeFromBuild="false" action="copy" targetDirectory="dap">
        </file>
        <file path="../dap/dap_interface.h" openOnCreation="false" excludeFromBuild="false" action="copy" targetDirectory="dap">
        </file>
