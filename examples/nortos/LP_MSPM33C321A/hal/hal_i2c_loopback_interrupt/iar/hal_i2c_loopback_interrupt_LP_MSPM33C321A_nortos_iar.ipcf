<?xml version="1.0" encoding="UTF-8"?>
<!-- IAR Project Connection File -->

<iarProjectConnection version="1.2" name="hal_i2c_loopback_interrupt" oneShot="true"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="IarProjectConnection_1.2.xsd">

    <device>
        <name>MSPM33C321A</name>
    </device>

    <asmIncludePath>
        <path>$PROJ_DIR$</path>
    </asmIncludePath>

    <includePath>
        <path>$PROJ_DIR$</path>
        <path>$MSPM33_SDK_INSTALL_DIR$/source/third_party/CMSIS/Core/Include</path>
        <path>$MSPM33_SDK_INSTALL_DIR$/examples/hal/I2c/hal_i2c_loopback_interrupt/LP_MSPM33C321A</path>
        <path>$MSPM33_SDK_INSTALL_DIR$/source/ti/hal/mspm33/include</path>
        <path>$MSPM33_SDK_INSTALL_DIR$/source/ti/hal/compiler/m33_ti_arm_clang</path>
        <path>$MSPM33_SDK_INSTALL_DIR$/source</path>
    </includePath>

    <defines>
        <define>__MSPM33C321A__</define>
    </defines>

    <extraOptions>
        <args>
            <arg>--silent</arg>
            <arg>-e</arg>
            <arg>--aeabi</arg>
            <arg>--thumb</arg>
            <arg>--diag_suppress=Pa050</arg>
        </args>
    </extraOptions>

    <linkerFile>
        <override>true</override>
        <path>$PROJ_DIR$/mspm33c321a.icf</path>
    </linkerFile>

    <linkerExtraOptions>
        <args>
            <arg>--redirect</arg>
            <arg>ScanfSmall=_ScanfSmall</arg>
            <arg>$MSPM33_SDK_INSTALL_DIR$/source/ti/driverlib/lib/iar/m33/mspm33c321x/driverlib.a</arg>
            <arg>-L$MSPM33_SDK_INSTALL_DIR$/source</arg>
            <arg>-L$PROJ_DIR$</arg>
            <arg>--silent</arg>
        </args>
    </linkerExtraOptions>

    <customBuildTools>
        <customBuildTool atRoot="true" name="SysConfig"> <!-- Custom build tool for entire project-->
            <fileExtensions>.syscfg</fileExtensions>
            <command>$SYSCONFIG_ROOT$/sysconfig_cli.bat -o $PROJ_DIR$ -s "$MSPM33_SDK_INSTALL_DIR$/.metadata/product.json" --compiler iar $FILE_PATH$</command>
            <output>
                <path>SysConfig_Generated_Files.ipcf</path>
            </output>
            <hasPrio>true</hasPrio> <!-- true: run this tool before all other tools-->
        </customBuildTool>
    </customBuildTools>

    <heaps>
        <heap> <!-- If omitted, id="0" -->
            <size>0</size>
        </heap>
        <heap id="1">
            <size>0</size>
        </heap>
    </heaps>
    <stacks>
        <stack> <!-- If omitted, id="0" -->
            <size>512</size>
        </stack>
    </stacks>


    <files>
        <path copyTo="$PROJ_DIR$/app_cfg.h">$MSPM33_SDK_INSTALL_DIR$/examples/nortos/LP_MSPM33C321A/hal/hal_i2c_loopback_interrupt/app_cfg.h</path>
        <path copyTo="$PROJ_DIR$/example.syscfg">$MSPM33_SDK_INSTALL_DIR$/examples/nortos/LP_MSPM33C321A/hal/hal_i2c_loopback_interrupt/example.syscfg</path>
        <path copyTo="$PROJ_DIR$/hal_i2c_loopback_interrupt.c">$MSPM33_SDK_INSTALL_DIR$/examples/nortos/LP_MSPM33C321A/hal/hal_i2c_loopback_interrupt/hal_i2c_loopback_interrupt.c</path>
        <path copyTo="$PROJ_DIR$/mspm33c321a.icf">$MSPM33_SDK_INSTALL_DIR$/examples/nortos/LP_MSPM33C321A/hal/hal_i2c_loopback_interrupt/iar/mspm33c321a.icf</path>
        <path copyTo="$PROJ_DIR$/README.html">$MSPM33_SDK_INSTALL_DIR$/examples/nortos/LP_MSPM33C321A/hal/hal_i2c_loopback_interrupt/README.html</path>
        <path copyTo="$PROJ_DIR$/README.md">$MSPM33_SDK_INSTALL_DIR$/examples/nortos/LP_MSPM33C321A/hal/hal_i2c_loopback_interrupt/README.md</path>
        <group name="iar" build="true">
            <path copyTo="$PROJ_DIR$/iar/startup_mspm33c321x_iar.c">$MSPM33_SDK_INSTALL_DIR$/examples/nortos/LP_MSPM33C321A/hal/hal_i2c_loopback_interrupt/iar/startup_mspm33c321x_iar.c</path>
        </group>
        <group name="ti/hal/mspm33/include" build="true">
            <path copyTo="$PROJ_DIR$/ti/hal/mspm33/include/I2c_Hal.h">$MSPM33_SDK_INSTALL_DIR$/examples/nortos/LP_MSPM33C321A/hal/hal_i2c_loopback_interrupt/ti/hal/mspm33/include/I2c_Hal.h</path>
            <path copyTo="$PROJ_DIR$/ti/hal/mspm33/include/I2c_Hal_Cfg.h">$MSPM33_SDK_INSTALL_DIR$/examples/nortos/LP_MSPM33C321A/hal/hal_i2c_loopback_interrupt/ti/hal/mspm33/include/I2c_Hal_Cfg.h</path>
            <path copyTo="$PROJ_DIR$/ti/hal/mspm33/include/Spi_Hal.h">$MSPM33_SDK_INSTALL_DIR$/examples/nortos/LP_MSPM33C321A/hal/hal_i2c_loopback_interrupt/ti/hal/mspm33/include/Spi_Hal.h</path>
            <path copyTo="$PROJ_DIR$/ti/hal/mspm33/include/Spi_Hal_Cfg.h">$MSPM33_SDK_INSTALL_DIR$/examples/nortos/LP_MSPM33C321A/hal/hal_i2c_loopback_interrupt/ti/hal/mspm33/include/Spi_Hal_Cfg.h</path>
            <path copyTo="$PROJ_DIR$/ti/hal/mspm33/include/Uart_Hal.h">$MSPM33_SDK_INSTALL_DIR$/examples/nortos/LP_MSPM33C321A/hal/hal_i2c_loopback_interrupt/ti/hal/mspm33/include/Uart_Hal.h</path>
            <path copyTo="$PROJ_DIR$/ti/hal/mspm33/include/Uart_Hal_Cfg.h">$MSPM33_SDK_INSTALL_DIR$/examples/nortos/LP_MSPM33C321A/hal/hal_i2c_loopback_interrupt/ti/hal/mspm33/include/Uart_Hal_Cfg.h</path>
        </group>
        <group name="ti/hal/mspm33/src/I2c" build="true">
            <path copyTo="$PROJ_DIR$/ti/hal/mspm33/src/I2c/I2c_Hal_Common.c">$MSPM33_SDK_INSTALL_DIR$/examples/nortos/LP_MSPM33C321A/hal/hal_i2c_loopback_interrupt/ti/hal/mspm33/src/I2c/I2c_Hal_Common.c</path>
            <path copyTo="$PROJ_DIR$/ti/hal/mspm33/src/I2c/I2c_Hal_Common.h">$MSPM33_SDK_INSTALL_DIR$/examples/nortos/LP_MSPM33C321A/hal/hal_i2c_loopback_interrupt/ti/hal/mspm33/src/I2c/I2c_Hal_Common.h</path>
