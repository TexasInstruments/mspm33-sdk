        </group>
        <group name="ti/hal/mspm33/src/Uart" build="true">
            <path copyTo="$PROJ_DIR$/ti/hal/mspm33/src/Uart/Uart_Hal.c">$MSPM33_SDK_INSTALL_DIR$/examples/nortos/LP_MSPM33C321A/hal/hal_i2c_loopback_interrupt/ti/hal/mspm33/src/Uart/Uart_Hal.c</path>
