<?xml version="1.0" encoding="UTF-8"?>
<projectSpec>
    <applicability>
        <when>
            <context
                deviceFamily="ARM"
                deviceId="MSPM33C321A"
            />
        </when>
    </applicability>

    <project
        title="memory_protect_secure"
        name="memory_protect_secure_LP_MSPM33C321A_nortos_ticlang"
        configurations="Debug"
        toolChain="TICLANG"
        connection="TIXDS110_Connection.xml"
        device="MSPM33C321A"
        ignoreDefaultDeviceSettings="true"
        ignoreDefaultCCSSettings="true"
        products="MSPM33-SDK;sysconfig"
        compilerBuildOptions="
            -I${PROJECT_ROOT}
            -I${PROJECT_ROOT}/${ConfigName}
            -D__ARM_ARCH=8
            -D__SAUREGION_PRESENT=1
            -D__MSPM33C321A__
            -O2
            -mfloat-abi=hard
            -mfpu=fpv5-sp-d16
            -mcmse
            -I${COM_TI_MSPM33_SDK_INSTALL_DIR}/source/third_party/CMSIS/Core/Include
            -I${COM_TI_MSPM33_SDK_INSTALL_DIR}/source
            -mcpu=cortex-m33
            -Wall
        "
        linkerBuildOptions="
            -Wl,--import_cmse_lib_out=implib.o
            -l${COM_TI_MSPM33_SDK_INSTALL_DIR}/source/ti/driverlib/lib/ticlang/m33/mspm33c321x/driverlib.a
            -L${COM_TI_MSPM33_SDK_INSTALL_DIR}/source
            -L${PROJECT_ROOT}
            -L${PROJECT_BUILD_DIR}/syscfg
            -Wl,--rom_model
            -Wl,--warn_sections
            -L${CG_TOOL_ROOT}/lib
            -llibc.a
        "
        sysConfigBuildOptions="
            --output .
            --product ${COM_TI_MSPM33_SDK_INSTALL_DIR}/.metadata/product.json
            --compiler ticlang
        "
        sourceLookupPath="${COM_TI_MSPM33_SDK_INSTALL_DIR}/source/ti/driverlib"
        description="memory_protect example for secure nonsecure">
        <property name="buildProfile" value="release"/>
        <property name="isHybrid" value="true"/>
        <file path="../config.h" openOnCreation="false" excludeFromBuild="false" action="copy">
        </file>
        <file path="../memory_protect.c" openOnCreation="false" excludeFromBuild="false" action="copy">
        </file>
        <file path="../nsc_example.c" openOnCreation="false" excludeFromBuild="false" action="copy">
        </file>
        <file path="../partition.h" openOnCreation="false" excludeFromBuild="false" action="copy">
        </file>
        <file path="../sns_helpers.h" openOnCreation="false" excludeFromBuild="false" action="copy">
        </file>
        <file path="../memory_protect.syscfg" openOnCreation="true" excludeFromBuild="false" action="copy">
        </file>
        <file path="../README.md" openOnCreation="true" excludeFromBuild="false" action="copy">
        </file>
        <file path="../README.html" openOnCreation="false" excludeFromBuild="false" action="copy">
        </file>
        <file path="../ticlang/mspm33c321a_s.cmd" openOnCreation="false" excludeFromBuild="false" action="copy">
        </file>
        <file path="../ticlang/startup_mspm33c321x_ticlang_s.c" openOnCreation="false" excludeFromBuild="false" action="copy">
        </file>
    </project>
</projectSpec>