<?xml version="1.0" encoding="UTF-8"?>
<projectSpec>
    <applicability>
        <when>
            <context
                deviceFamily="ARM"
                deviceId="MSPM33C321A"
            />
        </when>
    </applicability>
    <import spec="../../gpio_toggle_secure/gcc/gpio_toggle_secure_LP_MSPM33C321A_nortos_gcc.projectspec" />

    <project
        title="gpio_toggle_nonsecure"
        name="gpio_toggle_nonsecure_LP_MSPM33C321A_nortos_gcc"
        configurations="Debug"
        toolChain="GNU"
        connection="TIXDS110_Connection.xml"
        device="MSPM33C321A"
        ignoreDefaultDeviceSettings="true"
        ignoreDefaultCCSSettings="true"
        products="MSPM33-SDK;sysconfig"

        enableHexTool="true"
        compilerBuildOptions="
            -mcpu=cortex-m33
            -mthumb
            -mfloat-abi=hard
            -mfpu=fpv5-sp-d16
            -mlittle-endian
            -O2
            -I${INHERITED_INCLUDE_PATH}
            -I${COM_TI_MSPM33_SDK_INCLUDE_PATH}
            -I${SYSCONFIG_TOOL_INCLUDE_PATH}
            -I${PROJECT_ROOT}
            -I${PROJECT_ROOT}/${ConfigName}
            -I${COM_TI_MSPM33_SDK_INSTALL_DIR}/source/third_party/CMSIS/Core/Include
            -I${COM_TI_MSPM33_SDK_INSTALL_DIR}/source
            -I${CG_TOOL_ROOT}/arm-none-eabi/include
            -D${INHERITED_SYMBOLS}
            -D${COM_TI_MSPM33_SDK_SYMBOLS}
            -D${SYSCONFIG_TOOL_SYMBOLS}
            -D__MSPM33C321A__
            -D__ARM_ARCH=8
            -ffunction-sections
            -fdata-sections
            -g
            -gdwarf-3
            -gstrict-dwarf
            -Wall
            -std=c99
        "
        linkerBuildOptions="
            -mcpu=cortex-m33
            -mthumb
            -mfloat-abi=hard
            -mfpu=fpv5-sp-d16
            -Wl,-Map,${ProjName}.map
            -L${INHERITED_LIBRARY_PATH}
            -L${COM_TI_MSPM33_SDK_LIBRARY_PATH}
            -L${SYSCONFIG_TOOL_LIBRARY_PATH}
            -L${COM_TI_MSPM33_SDK_INSTALL_DIR}/source
            -L${PROJECT_ROOT}
            -L${PROJECT_BUILD_DIR}/syscfg
            -L${CG_TOOL_ROOT}/arm-none-eabi/lib/thumb/v8-m.main+fp/hard
            -Wl,--gc-sections
            ${CCS_WORKSPACE_DIR}/gpio_toggle_secure_LP_MSPM33C321A_nortos_gcc/Debug/implib.o
            -l${COM_TI_MSPM33_SDK_INSTALL_DIR}/source/ti/driverlib/lib/gcc/m33/mspm33c321x/driverlib.a
            -lgcc
            -lc
            -lm
            -lnosys
        "
        sysConfigBuildOptions="
            -o . -s ${INHERITED_SYSCONFIG_MANIFESTS} -s ${COM_TI_MSPM33_SDK_SYSCONFIG_MANIFEST} -s ${SYSCONFIG_TOOL_SYSCONFIG_MANIFEST}
        "
        sourceLookupPath="${COM_TI_MSPM33_SDK_INSTALL_DIR}/source/ti/driverlib"
        description="gpio_toggle nonsecure example for a secure nonsecure gpio_toggle example set"
        references="gpio_toggle_secure_LP_MSPM33C321A_nortos_gcc">

        <dependencies>
            <dependency project="gpio_toggle_secure_LP_MSPM33C321A_nortos_gcc" />
        </dependencies>

        <property name="buildProfile" value="release"/>
        <property name="isHybrid" value="true"/>
        <file path="mspm33c321a_ns.lds" openOnCreation="false" excludeFromBuild="false" action="copy" type="linkerCommandFile"></file>
        <file path="startup_mspm33c321x_gcc_ns.c" openOnCreation="false" excludeFromBuild="false" action="copy"></file>
        <file path="${COM_TI_MSPM33_SDK_INSTALL_DIR}/source/ti/devices/msp/m33/startup_system_files/system_mspm33c321x.c" openOnCreation="false" excludeFromBuild="false" action="link"></file>
        <file path="../gpio_toggle_ns.c" openOnCreation="false" excludeFromBuild="false" action="copy"></file>
        <file path="../gpio_toggle.syscfg" openOnCreation="true" excludeFromBuild="false" action="copy"></file>
        <file path="../nsc_example.h" openOnCreation="false" excludeFromBuild="false" action="copy"></file>
        <file path="../README.md" openOnCreation="false" excludeFromBuild="false" action="copy"></file>
    </project>
</projectSpec>
