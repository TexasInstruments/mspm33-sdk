<?xml version="1.0" encoding="UTF-8"?>
<projectSpec>
    <applicability>
        <when>
            <context
                deviceFamily="ARM"
                deviceId="MSPM33C321A"
            />
        </when>
    </applicability>

    <import spec="${COM_TI_MSPM33_SDK_INSTALL_DIR}/kernel/freertos/builds/LP_MSPM33C321A/release/gcc/freertos_builds_LP_MSPM33C321A_release_gcc.projectspec"/>

    <project
        title="blink_led"
        name="blink_led_LP_MSPM33C321A_freertos_gcc"
        configurations="Debug"
        toolChain="GNU"
        connection="TIXDS110_Connection.xml"
        device="MSPM33C321A"
        ignoreDefaultDeviceSettings="true"
        ignoreDefaultCCSSettings="true"
        references="freertos_builds_LP_MSPM33C321A_release_gcc"
        products="sysconfig"
        compilerBuildOptions="
            -I${PROJECT_ROOT}
            -I${PROJECT_ROOT}/${ConfigName}
            -D__MSPM33C321A__
            -O2
            -mfloat-abi=hard
            -mfpu=fpv5-sp-d16
            -I${COM_TI_MSPM33_SDK_INSTALL_DIR}/source/third_party/CMSIS/Core/Include
            -I${COM_TI_MSPM33_SDK_INSTALL_DIR}/kernel/freertos/Source/include
            -I${COM_TI_MSPM33_SDK_INSTALL_DIR}/source
            -I${COM_TI_MSPM33_SDK_INSTALL_DIR}/kernel/freertos/Source/portable/GCC/ARM_CM33_NTZ/non_secure
            -I${COM_TI_MSPM33_SDK_INSTALL_DIR}/source/ti/posix/gcc
            -I${WORKSPACE_LOC}/freertos_builds_LP_MSPM33C321A_release_gcc
            -mcpu=cortex-m33
            -mthumb
            -std=c99
            -std=c++11
            -ffunction-sections
            -fdata-sections
            -g
            -Wall
            -I${CG_TOOL_ROOT}/arm-none-eabi/include
        "
        linkerBuildOptions="
            -L${COM_TI_MSPM33_SDK_INSTALL_DIR}/source/ti/driverlib/lib/gcc/m33/mspm33c321x
            -nostartfiles
            -mfloat-abi=hard
            -mfpu=fpv5-sp-d16
            -l:driverlib.a
            -L${COM_TI_MSPM33_SDK_INSTALL_DIR}/source
            -L${PROJECT_ROOT}
            --specs=nosys.specs
            -L${PROJECT_BUILD_DIR}/syscfg
            -L${WORKSPACE_LOC}/freertos_builds_LP_MSPM33C321A_release_gcc/Debug
            -l:libfreertos_builds_LP_MSPM33C321A_release_gcc.a
            -mcpu=cortex-m33
            -mthumb
            -static
            -Wl,--gc-sections
            -lgcc
            -lc
            -lm
        "
        sysConfigBuildOptions="
            --output .
            --product ${COM_TI_MSPM33_SDK_INSTALL_DIR}/.metadata/product.json
            --compiler gcc
        "
        sourceLookupPath="${COM_TI_MSPM33_SDK_INSTALL_DIR}/source/ti/driverlib"
        description="Simple FreeRTOS LED blinky demo using two tasks">
        <property name="buildProfile" value="release"/>
        <property name="isHybrid" value="true"/>
        <file path="../../main.c" openOnCreation="false" excludeFromBuild="false" action="copy">
        </file>
        <file path="../../main-blinky.c" openOnCreation="false" excludeFromBuild="false" action="copy">
        </file>
        <file path="../../syscfg_c.rov.xs" openOnCreation="false" excludeFromBuild="true" action="copy">
        </file>
        <file path="../../blink_led.syscfg" openOnCreation="true" excludeFromBuild="false" action="copy">
        </file>
        <file path="../../README.md" openOnCreation="true" excludeFromBuild="false" action="copy">
        </file>
        <file path="../../README.html" openOnCreation="false" excludeFromBuild="false" action="copy">
        </file>
        <file path="../../freertos/gcc/mspm33c321a.lds" openOnCreation="false" excludeFromBuild="false" action="copy">
        </file>
        <file path="../../freertos/gcc/startup_mspm33c321x_gcc.c" openOnCreation="false" excludeFromBuild="false" action="copy" targetDirectory="freertos/gcc">
        </file>
        <file path="../../freertos/gcc/system_mspm33c321x.c" openOnCreation="false" excludeFromBuild="false" action="copy" targetDirectory="freertos/gcc">
        </file>
    </project>
</projectSpec>