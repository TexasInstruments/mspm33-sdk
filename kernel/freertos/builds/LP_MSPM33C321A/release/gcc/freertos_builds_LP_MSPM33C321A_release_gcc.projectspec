<?xml version="1.0" encoding="UTF-8"?>
<projectSpec>
    <applicability>
        <when>
            <context
                deviceFamily="ARM"
                deviceId="MSPM33C321A"
            />
        </when>
    </applicability>

    <project
        title="FreeRTOS build release configuration"
        name="freertos_builds_LP_MSPM33C321A_release_gcc"
        device="MSPM33C321A"
        toolChain="GNU"
        outputType="staticLibrary"
        compilerBuildOptions="
            -D__MSPM33C321A__
            -Og
            -I${PROJECT_ROOT}
            -I${COM_TI_MSPM33_SDK_INSTALL_DIR}/kernel/freertos/Source/include
            -I${COM_TI_MSPM33_SDK_INSTALL_DIR}/kernel/freertos/Source/portable/GCC/ARM_CM33_NTZ/non_secure
            -I${COM_TI_MSPM33_SDK_INSTALL_DIR}/source/third_party/CMSIS/Core/Include
            -I${COM_TI_MSPM33_SDK_INSTALL_DIR}/source
            -I${CG_TOOL_ROOT}/arm-none-eabi/include
            -mcpu=cortex-m33
            -mthumb
            -std=c99
            -std=c++11
            -mfloat-abi=hard
            -mfpu=fpv5-sp-d16
            -ffunction-sections
            -fdata-sections
            -g
            -gstrict-dwarf
            -Wall
        "
        ignoreDefaultDeviceSettings="true"
        ignoreDefaultCCSSettings="true"
        description="A FreeRTOS release configuration project">

        <property name="products" value="MSPM33-SDK"/>
        <property name="buildProfile" value="release"/>
        <group id="MSPM33_SDK.LP_MSPM33C321A.release.ccs"/>
        <file path="${COM_TI_MSPM33_SDK_INSTALL_DIR}/kernel/freertos/Source/croutine.c" openOnCreation="false" excludeFromBuild="false" action="link" targetDirectory="freertos" >
        </file>
        <file path="${COM_TI_MSPM33_SDK_INSTALL_DIR}/kernel/freertos/Source/event_groups.c" openOnCreation="false" excludeFromBuild="false" action="link" targetDirectory="freertos" >
        </file>
        <file path="${COM_TI_MSPM33_SDK_INSTALL_DIR}/kernel/freertos/Source/list.c" openOnCreation="false" excludeFromBuild="false" action="link" targetDirectory="freertos" >
        </file>
        <file path="${COM_TI_MSPM33_SDK_INSTALL_DIR}/kernel/freertos/Source/queue.c" openOnCreation="false" excludeFromBuild="false" action="link" targetDirectory="freertos" >
        </file>
        <file path="${COM_TI_MSPM33_SDK_INSTALL_DIR}/kernel/freertos/Source/stream_buffer.c" openOnCreation="false" excludeFromBuild="false" action="link" targetDirectory="freertos" >
        </file>
        <file path="${COM_TI_MSPM33_SDK_INSTALL_DIR}/kernel/freertos/Source/tasks.c" openOnCreation="false" excludeFromBuild="false" action="link" targetDirectory="freertos" >
        </file>
        <file path="${COM_TI_MSPM33_SDK_INSTALL_DIR}/kernel/freertos/Source/timers.c" openOnCreation="false" excludeFromBuild="false" action="link" targetDirectory="freertos" >
        </file>
        <file path="${COM_TI_MSPM33_SDK_INSTALL_DIR}/kernel/freertos/Source/portable/MemMang/heap_1.c" openOnCreation="false" excludeFromBuild="true" action="link" targetDirectory="freertos" >
        </file>
        <file path="${COM_TI_MSPM33_SDK_INSTALL_DIR}/kernel/freertos/Source/portable/MemMang/heap_2.c" openOnCreation="false" excludeFromBuild="true" action="link" targetDirectory="freertos" >
        </file>
        <file path="${COM_TI_MSPM33_SDK_INSTALL_DIR}/kernel/freertos/Source/portable/MemMang/heap_3.c" openOnCreation="false" excludeFromBuild="true" action="link" targetDirectory="freertos" >
        </file>
        <file path="${COM_TI_MSPM33_SDK_INSTALL_DIR}/kernel/freertos/Source/portable/MemMang/heap_4.c" openOnCreation="false" excludeFromBuild="false" action="link" targetDirectory="freertos" >
        </file>
        <file path="${COM_TI_MSPM33_SDK_INSTALL_DIR}/kernel/freertos/Source/portable/MemMang/heap_5.c" openOnCreation="false" excludeFromBuild="true" action="link" targetDirectory="freertos" >
        </file>
        <file path="${COM_TI_MSPM33_SDK_INSTALL_DIR}/kernel/freertos/Source/portable/GCC/ARM_CM33_NTZ/non_secure/port.c" openOnCreation="false" excludeFromBuild="false" action="link" targetDirectory="freertos/portable/GCC/ARM_CM33_NTZ/non_secure" >
        </file>
        <file path="${COM_TI_MSPM33_SDK_INSTALL_DIR}/kernel/freertos/Source/portable/GCC/ARM_CM33_NTZ/non_secure/portasm.c" openOnCreation="false" excludeFromBuild="false" action="link" targetDirectory="freertos/portable/GCC/ARM_CM33_NTZ/non_secure" >
        </file>
        <file path="${COM_TI_MSPM33_SDK_INSTALL_DIR}/kernel/freertos/Source/portable/GCC/ARM_CM33_NTZ/non_secure/mpu_wrappers_v2_asm.c" openOnCreation="false" excludeFromBuild="false" action="link" targetDirectory="freertos/portable/GCC/ARM_CM33_NTZ/non_secure" >
        </file>
        <file path="${COM_TI_MSPM33_SDK_INSTALL_DIR}/source/ti/devices/msp/m33/startup_system_files/gcc/startup_mspm33c321x_gcc.c" openOnCreation="false" excludeFromBuild="false" action="copy" targetDirectory="freertos/startup" >
        </file>
        <file path="../FreeRTOSConfig.h" openOnCreation="false" excludeFromBuild="false" action="copy" >
        </file>
        <file path="../README.md" openOnCreation="false" excludeFromBuild="false" action="copy" >
        </file>
    </project>
</projectSpec>
