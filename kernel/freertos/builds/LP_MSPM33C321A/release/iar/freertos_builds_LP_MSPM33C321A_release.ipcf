      <path reference="$PROJ_DIR$/timers.c">$MSPM33_SDK_INSTALL_DIR$/kernel/freertos/Source/timers.c</path>
      <path reference="$PROJ_DIR$/port.c">$MSPM33_SDK_INSTALL_DIR$/kernel/freertos/Source/portable/IAR/ARM_CM33_NTZ/non_secure/port.c</path>
      <path reference="$PROJ_DIR$/portasm.s">$MSPM33_SDK_INSTALL_DIR$/kernel/freertos/Source/portable/IAR/ARM_CM33_NTZ/non_secure/portasm.s</path>
