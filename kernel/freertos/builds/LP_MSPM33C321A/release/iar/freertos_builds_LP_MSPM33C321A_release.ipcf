      <arg>-I$PROJ_DIR$/..</arg>
      <arg>--debug</arg>
      <arg>--silent</arg>
      <arg>-e</arg>
      <arg>--aeabi</arg>
      <arg>--thumb</arg>
      <arg>--diag_suppress=Pa050</arg>
    </args>
  </extraOptions>

  <asmIncludePath>
    <path>$MSPM33_SDK_INSTALL_DIR$/kernel/freertos/Source/include</path>
    <path>$PROJ_DIR$/..</path>
